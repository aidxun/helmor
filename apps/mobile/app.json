{
	"expo": {
		"name": "Helmor Mobile",
		"slug": "helmor-mobile",
		"version": "0.1.0",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "helmor",
		"userInterfaceStyle": "automatic",
		"ios": {
			"bundleIdentifier": "dev.helmor.mobile",
			"supportsTablet": true,
			"infoPlist": {
				"ITSAppUsesNonExemptEncryption": false,
				"NSLocalNetworkUsageDescription": "Helmor Mobile connects to Helmor Desktop on your local network to sync workspaces and send backlog tasks.",
				"UIViewControllerBasedStatusBarAppearance": true
			}
		},
		"android": {
			"package": "dev.helmor.mobile",
			"adaptiveIcon": {
				"foregroundImage": "./assets/images/icon.png",
				"backgroundColor": "#10110F"
			},
			"predictiveBackGestureEnabled": false
		},
		"web": {
			"bundler": "metro",
			"output": "static"
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"image": "./assets/images/splash-icon.png",
					"imageWidth": 200,
					"resizeMode": "contain",
					"backgroundColor": "#F7F7F5",
					"dark": {
						"backgroundColor": "#161715"
					}
				}
			],
			"expo-asset",
			"expo-font",
			"expo-image",
			"expo-web-browser",
			"expo-system-ui",
			"expo-status-bar",
			"expo-dev-client",
			[
				"react-native-enriched-markdown",
				{
					"enableMath": false
				}
			],
			"./plugins/with-nmssh"
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		}
	}
}
